{
  "name": "frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "cleanup": "npx rimraf ./dist",
    "dev": "vite --mode dev",
    "build:dev": "npm run cleanup && vite build --mode dev",
    "build:stg": "npm run cleanup && vite build --mode stg",
    "build": "vite build --mode prod",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "format": "prettier --write ./src/**/*.{ts,tsx}",
    "lint": "eslint './src/**/*.{ts,tsx,jsx}'",
    "fix:lint": "eslint './src/**/*.{ts,tsx,jsx}' --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@mui/icons-material": "^6.0.0",
    "@mui/material": "^6.0.0",
    "@mui/styled-engine-sc": "^6.0.0-alpha.6",
    "axios": "^1.0.0",
    "dompurify": "^3.1.7",
    "immer": "^10.1.1",
    "material-ui-popup-state": "^5.0.10",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0",
    "react-loading": "^2.0.3",
    "react-router-dom": "7.0.2",
    "react-scroll": "^1.8.6",
    "typescript": "^5.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/addon-onboarding": "^1.0.11",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "8.4.7",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.2.0",
    "@types/dompurify": "^3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-scroll": "^1.8.7",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-storybook": "^0.11.0",
    "happy-dom": "^15.8.0",
    "prettier": "^3.0.1",
    "react-test-renderer": "^18.0.0",
    "rimraf": "^6.0.0",
    "storybook": "^8.4.7",
    "vite": "^5.2.12",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.4",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "yarn@4.5.3"
}
