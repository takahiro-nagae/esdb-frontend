{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@mui/icons-material": "^5.3.1",
    "@mui/material": "^5.8.1",
    "@mui/styled-engine-sc": "^5.3.0",
    "axios": "^0.27.0",
    "material-ui-popup-state": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.26.1",
    "react-loading": "^2.0.3",
    "react-responsive": "^9.0.0-beta.6",
    "react-router-dom": "6.3.0",
    "react-scroll": "^1.8.6",
    "styled-components": "^6.0.0",
    "typescript": "^4.5.4",
    "web-vitals": "^3.0.0"
  },
  "scripts": {
    "cleanup": "npx rimraf ./dist",
    "dev": "npm run build:dev && npm run webpack:server",
    "webpack:server": "npx webpack-dev-server --config ./webpack.dev.js",
    "build:dev": "npm run cleanup && webpack --config ./webpack.dev.js",
    "build": "npx webpack --config ./webpack.prod.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config ./jest.config.js",
    "format": "prettier --write ./src/**/*.{ts,tsx}",
    "lint": "eslint './src/**/*.{ts,tsx,jsx}'",
    "fix:lint": "eslint './src/**/*.{ts,tsx,jsx}' --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-react": "^7.22.5",
    "@emotion/babel-preset-css-prop": "^11.11.0",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^14.2.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.6",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-scroll": "^1.8.7",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "babel-jest": "^29.6.2",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-webpack-plugin": "^4.0.1",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "prettier": "^3.0.1",
    "react-test-renderer": "^18.0.0",
    "rimraf": "^5.0.1",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.9.0"
  },
  "jest": {
    "testEnvironment": "jsdom"
  }
}
