{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "@mui/styled-engine-sc": "^6.0.0-alpha.6",
    "axios": "^1.0.0",
    "material-ui-popup-state": "^5.0.10",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.26.1",
    "react-loading": "^2.0.3",
    "react-router-dom": "6.27.0",
    "react-scroll": "^1.8.6",
    "styled-components": "^6.1.1",
    "typescript": "^5.0.0",
    "web-vitals": "^3.5.0"
  },
  "scripts": {
    "cleanup": "npx rimraf ./dist",
    "dev": "vite --mode dev",
    "build:dev": "npm run cleanup && vite build --mode dev",
    "build:stg": "npm run cleanup && vite build --mode stg",
    "build": "vite build --mode prod",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config ./jest.config.js",
    "format": "prettier --write ./src/**/*.{ts,tsx}",
    "lint": "eslint './src/**/*.{ts,tsx,jsx}'",
    "fix:lint": "eslint './src/**/*.{ts,tsx,jsx}' --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^7.5.3",
    "@storybook/addon-interactions": "^7.5.3",
    "@storybook/addon-links": "^7.5.3",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.5.3",
    "@storybook/react": "^7.5.3",
    "@storybook/react-vite": "^8.1.5",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.2.0",
    "@types/dompurify": "^3",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.9.2",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-scroll": "^1.8.7",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "css-loader": "^6.8.1",
    "dompurify": "^3.0.6",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-storybook": "^0.6.15",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "prettier": "^3.0.1",
    "react-test-renderer": "^18.0.0",
    "rimraf": "^5.0.5",
    "storybook": "^7.5.3",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "vite": "^5.2.12",
    "vite-plugin-env-compatible": "^2.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "packageManager": "yarn@4.0.2"
}
